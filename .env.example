# =============================================================================
# SIH 2026 Live Submission Tracker — Environment Variables
# =============================================================================
# Copy this file to .env (backend) and frontend/.env.local (frontend)
# and fill in your actual values before running the app.
# NEVER commit .env or .env.local to version control.
# =============================================================================

# ------------------------------------------------------------------------------
# BACKEND (Python / FastAPI) — copy to backend/.env
# ------------------------------------------------------------------------------

# SIH Source Configuration
SIH_SOURCE_URL=https://sih.gov.in/sih2026PS
COLLECTOR_INTERVAL_SECONDS=60

# Firebase Admin SDK (from Firebase Console > Project Settings > Service Accounts)
# Generate a new private key and copy the values here (not the JSON file path)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIIEowIBAAKCAQEA...\n-----END RSA PRIVATE KEY-----\n"

# Server
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ------------------------------------------------------------------------------
# FRONTEND (React / Vite) — copy to frontend/.env.local
# ------------------------------------------------------------------------------
# All VITE_ variables are exposed to the browser bundle (public values only)
# Get these from Firebase Console > Project Settings > Your Apps > Web App

VITE_FIREBASE_API_KEY=AIzaSy...
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abc123def456
VITE_FIREBASE_VAPID_KEY=BHxxxxxxxxxxxxxxxx...

# Backend API URL (used in production — in dev, Vite proxies /api to localhost:8000)
VITE_API_BASE_URL=https://your-backend.run.app
