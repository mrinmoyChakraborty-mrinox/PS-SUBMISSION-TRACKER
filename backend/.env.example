# SIH Source Configuration
SIH_SOURCE_URL=https://sih.gov.in/sih2026PS
COLLECTOR_INTERVAL_SECONDS=60

# Cloudflare Worker Proxy (REQUIRED on cloud hosts — bypass 403 block)
# Deploy cloudflare-worker/sih-proxy.js and paste the Worker URL below
WORKER_PROXY_URL=https://sih-proxy.YOUR-NAME.workers.dev
WORKER_PROXY_SECRET=

# Firebase Admin SDK (service account)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n"

# Server
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
